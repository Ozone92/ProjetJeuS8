  m_Name: Professor
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  dialogs:
  - id: Begin
    speaker: Professeur T
    text: "Bon, c\u2019est termin\xE9, passons au moment que vous attendiez tous."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Prof2
      statsToChange: []
      minimalCondition: []
  - id: Prof2
    speaker: Professeur T
    text: "Comme je vous avait dit au d\xE9but de la s\xE9ance, vous \xEAtes not\xE9s
      sur votre technique mais aussi sur votre ambiance de groupe."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Prof3
      statsToChange: []
      minimalCondition: []
  - id: Prof3
    speaker: Professeur T
    text: "Etant Thanos je sais donc si vous vous \xEAtes bien entendu avec les membres
      de votre groupe."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Prof4
      statsToChange: []
      minimalCondition: []
  - id: Prof4
    speaker: Professeur T
    text: "Bon assez parl\xE9 on va commencer par le groupe de 3 personnes."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Prof5
      statsToChange: []
      minimalCondition: []
  - id: Prof5
    speaker: Professeur T
    text: '*prend le soda*'
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Prof6
      statsToChange: []
      minimalCondition: []
  - id: Prof6
    speaker: Professeur T
    text: '*boit le soda* glou glou glou'
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 0, z: 0}
    cameraRotation: {x: 0, y: 0, z: 0}
