  dialogs:
  - id: Begin
    speaker: Speed
    text: "On pourrait s'inspirer de sodas d\xE9j\xE0 existants, mais \xE7a m'a lair
      tr\xE8s chimique"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.128, y: 0.171, z: 0.283}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: nerdSain
      statsToChange: []
      minimalCondition: []
  - id: nerdSain
    speaker: Uryu
    text: En effet, si on veut quelque chose de plus sain, il faudrait mettre des
      sucres et colorants naturels.
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.032, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: hbOlive
      statsToChange: []
      minimalCondition: []
  - id: hbOlive
    speaker: Speed
    text: J'aimerais bien faire un soda vert.
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.128, y: 0.171, z: 0.283}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: playerOlive
      statsToChange: []
      minimalCondition: []
  - id: playerOlive
    speaker: Vous
    text: "Vers o\xF9 ? LOL"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: nerdNaturel
      statsToChange:
      - name: C1G1
        amount: 1
      minimalCondition: []
  - id: nerdNaturel
    speaker: Uryu
    text: "Arr\xEAtons les blagues, partons sur une ar\xF4me et un colorant menthe.
      Pour les sucres, le sirop de ma\xEFs devrait faire l'affaire."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices: []
