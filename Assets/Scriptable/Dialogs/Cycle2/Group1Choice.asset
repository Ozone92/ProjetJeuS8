  m_Script: {fileID: 11500000, guid: 47e8c251aa9a4d95ca6b84096cf8588c, type: 3}
  m_Name: Group1Choice
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  dialogs:
  - id: Begin
    speaker: HB
    text: "OK les gars laissez moi faire, j\u2019adore nettoyer des trucs."
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vous1
      statsToChange: []
      minimalCondition: []
  - id: Vous1
    speaker: Vous
    text: " Pourquoi tu fais genre t\u2019es un mec propre ?"
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: HB2
      statsToChange: []
      minimalCondition: []
  - id: HB2
    speaker: HB
    text: Azy toi svp laisse moi faire.
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Nerd1
      statsToChange: []
      minimalCondition: []
  - id: Nerd1
    speaker: Nerd
    text: "T\u2019es sur t\u2019as bien \xE9cout\xE9 et tu sauras suivre le protocol
      ? j\u2019ai pas envie de me salir je ne manipule pas moi."
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: HB3
      statsToChange: []
      minimalCondition: []
  - id: HB3
    speaker: HB
    text: Mais tu connais bien le protocole pourtant.
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Nerd2
      statsToChange: []
      minimalCondition: []
  - id: Nerd2
    speaker: Nerd
    text: Vous vous reposez trop sur moi ca saoule, tu peux le faire toi sinon.
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Choix
      statsToChange: []
      minimalCondition: []
  - id: Choix
    speaker: Vous
    text: Qui s'en occupe ?
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: HB
      idToGo: HB_Vous1
      statsToChange:
      - name: GroupScore
        amount: 1
      - name: TpScore
        amount: -1
      minimalCondition: []
    - text: Nerd
      idToGo: Nerd_Vous1
      statsToChange:
      - name: GroupScore
        amount: -1
      - name: TpScore
        amount: 1
      minimalCondition: []
    - text: Vous
      idToGo: Vous_Vous1
      statsToChange:
      - name: DoMinigame2
        amount: 1
      minimalCondition: []
  - id: HB_Vous1
    speaker: Vous
    text: "Vazy HB, on te laisse g\xE9rer."
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: HB_Nerd1
      statsToChange: []
      minimalCondition: []
  - id: HB_Nerd1
    speaker: Nerd
    text: "T\u2019as int\xE9r\xEAt \xE0 g\xE9rer."
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: HB_HB1
      statsToChange: []
      minimalCondition: []
  - id: HB_HB1
    speaker: HB
    text: '*flexes his muscles*'
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: 
      statsToChange:
      - name: CycleFinish2
        amount: 1
      minimalCondition: []
  - id: Nerd_Vous1
    speaker: Vous
    text: "Nerd stp tu peux t\u2019en occuper quand m\xEAme, t\u2019es le plus s\xE9rieux
      d\u2019entre nous."
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: Nerd_Nerd1
      statsToChange: []
      minimalCondition: []
  - id: Nerd_Nerd1
    speaker: Nerd
    text: "Faut vraiment tout faire ici. Vous avez de la chance c\u2019est not\xE9."
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Nerd_HB1
      statsToChange: []
      minimalCondition: []
  - id: Nerd_HB1
    speaker: HB
    text: Azy tu me fais pas confiance ou quoi ?!
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Nerd_Vous2
      statsToChange: []
      minimalCondition: []
  - id: Nerd_Vous2
    speaker: Vous
    text: Bah nan mdr
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Nerd_HB2
      statsToChange: []
      minimalCondition: []
  - id: Nerd_HB2
    speaker: HB
    text: Pffff...
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: 
      statsToChange:
      - name: CycleFinish2
        amount: 1
      minimalCondition: []
  - id: Vous_Vous1
    speaker: Vous
    text: Je vais le faire, j'vais faire de mon mieux
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vous_Nerd1
      statsToChange: []
      minimalCondition: []
  - id: Vous_Nerd1
    speaker: Nerd
    text: "T\u2019as int\xE9r\xEAt \xE0 g\xE9rer"
    cameraPosition: {x: -0.032, y: 0.1556, z: 0.5145}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vous_HB1
      statsToChange: []
      minimalCondition: []
  - id: Vous_HB1
    speaker: HB
    text: "Oue vraiment, surtout vu comment tu forces j'tavais dit j\u2019\xE9tais
      chaud de le faire."
    cameraPosition: {x: -0.128, y: 0.171, z: 0.384}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: 
      statsToChange:
      - name: CycleFinish2
        amount: 1
      minimalCondition: []
