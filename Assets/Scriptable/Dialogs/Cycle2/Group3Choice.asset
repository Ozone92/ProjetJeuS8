      minimalCondition: []
  - id: Vieux_Vous1
    speaker: Vous
    text: Ok heisenberg on te laisse cook
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vieux_Vieux1
      statsToChange: []
      minimalCondition: []
  - id: Vieux_Vieux1
    speaker: Vieux
    text: Jesse lets cook
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vieux_Cousin1
      statsToChange: []
      minimalCondition: []
  - id: Vieux_Cousin1
    speaker: Cousin
    text: c qui jesse ? je veux bien aider moi
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vieux_Vous2
      statsToChange: []
      minimalCondition: []
  - id: Vieux_Vous2
    speaker: Vous
    text: "\u2026 va aider je te regarde j\u2019ai besoin de m\u2019assoir c\u2019est
