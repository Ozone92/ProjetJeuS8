  dialogs:
  - id: Begin
    speaker: Vieux
    text: "Le petit peu \xE0 peine tenir les objets et voir le plan de travail."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Cousin1
      statsToChange: []
      minimalCondition: []
  - id: Cousin1
    speaker: Cousin
    text: Naaan je veux le faire, svp laissez moi faire !!
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vieux2
      statsToChange: []
      minimalCondition: []
  - id: Vieux2
    speaker: Vieux
    text: "Ca me connait le nettoyage et la st\xE9rilisation. Je cookais de la meth
      \xE0 l\u2019\xE9poque."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Cousin2
      statsToChange: []
      minimalCondition: []
  - id: Cousin2
    speaker: Cousin
    text: "C\u2019est quoi la meth ?"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Vous1
      statsToChange: []
      minimalCondition: []
  - id: Vous1
    speaker: Vous
    text: "hum\u2026 oublie *il faut que j'emp\xEAche mon cousin de trop le fr\xE9quenter
      lui\u2026*"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Choix
      statsToChange: []
      minimalCondition: []
  - id: Choix
    speaker: Vous
    text: Qui s'en occupe ?
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: Cousin
      idToGo: Cousin_Vous1
      statsToChange:
      - name: GroupScore
        amount: 1
      - name: TpScore
        amount: 0
      minimalCondition: []
    - text: Vieux
      idToGo: Vieux_Vous1
      statsToChange:
      - name: GroupScore
        amount: 0
      - name: TpScore
        amount: 1
      minimalCondition: []
    - text: Vous
      idToGo: Vous_Vous1
      statsToChange:
      - name: DoMinigame2
        amount: 1
      minimalCondition: []
  - id: Cousin_Vous1
    speaker: Vous
    text: Vazy le couz, fais attention par contre
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Cousin_Cousin1
      statsToChange: []
      minimalCondition: []
  - id: Cousin_Cousin1
    speaker: Cousin
    text: "Youhou merci les gars ca va \xEAtre trop marrant"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Cousin_Vieux1
      statsToChange: []
      minimalCondition: []
  - id: Cousin_Vieux1
    speaker: Vieux
    text: "J\u2019avais pas autant d'\xE9nergie quand j\u2019avais son \xE2ge, c\u2019est
      beau la jeunesse"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Cousin_Vous2
      statsToChange: []
      minimalCondition: []
  - id: Cousin_Vous2
    speaker: Vous
    text: Concentrons nous sur le tp svp
