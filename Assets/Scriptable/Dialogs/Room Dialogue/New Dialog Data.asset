  m_Script: {fileID: 11500000, guid: 47e8c251aa9a4d95ca6b84096cf8588c, type: 3}
  m_Name: New Dialog Data
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  dialogs:
  - id: 1
    speaker: Maman
    text: "R\xE9veille toi mon ch\xE9ri tu vas \xEAtre en retard !"
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: 2
      statsToChange: []
      minimalCondition: []
  - id: 2
    speaker: Vous
    text: "Argh... je d\xE9teste le lundi !"
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: 3
      statsToChange: []
      minimalCondition: []
  - id: 3
    speaker: Vous
    text: "Il est d\xE9j\xE0 8h50 ? Je vais \xEAtre en retard !"
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: 4
      statsToChange:
      - name: Reveil
        amount: 1
      minimalCondition: []
  - id: 4
    speaker: Maman
    text: N'oublie pas que tu as un TP de chimie aujourd'hui !
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: 5
      statsToChange: []
      minimalCondition: []
  - id: 5
    speaker: Vous
    text: "Merde j'avais oubli\xE9 ! D\xE9j\xE0 que j'ai foir\xE9 le TP avec Xiao
      la derni\xE8re fois et maintenant il me d\xE9teste..."
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: 
      idToGo: 6
      statsToChange: []
      minimalCondition: []
  - id: 8
    speaker: Vous
    text: "En m\xEAme temps, je d\xE9teste la chimie je pourrais juste rester ici
      et profiter de ma matin\xE9e..."
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices: []
  - id: 6
    speaker: Vous
    text: Qu'est ce que je vais faire ?
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices:
    - text: Aller au TP
      idToGo: Choix1
      statsToChange: []
      minimalCondition: []
    - text: Se rendormir
      idToGo: Choix2
      statsToChange: []
      minimalCondition: []
  - id: Choix1
    speaker: Vous
    text: "Bon j'imagine que je n'ai pas le choix... Speed m'avait d\xE9j\xE0 pr\xE9venu
      que le prof n'allait pas me l\xE2cher de toute fa\xE7on"
    useDefaultCameraTransform: 1
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0, y: 1, z: -10}
    cameraRotation: {x: 0, y: 0, z: 0}
    choices: []
