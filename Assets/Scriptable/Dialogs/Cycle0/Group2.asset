  dialogs:
  - id: Begin
    speaker: Xiao
    text: "T'as pas int\xEAret \xE0 ruiner mon TP comme la derni\xE8re fois. D\xE9j\xE0
      que je suis avec ce d\xE9bile de Renji"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0.193, y: 0.171, z: 0.283}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: BunText
      statsToChange: []
      minimalCondition: []
  - id: BunText
    speaker: Renji
    text: "On va pas refuser quelqu\u2019un en plus, ca me permettra de rien fai\u2026
      euh d\u2019aller plus vite !"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0.32, y: 0.17, z: 0.3}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Choix
      statsToChange: []
      minimalCondition: []
  - id: Choix
    speaker: Vous
    text: 'Rejoindre ce groupe ? '
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0.32, y: 0.17, z: 0.3}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: Oui
      idToGo: Join
      statsToChange:
      - name: Group
        amount: 2
      - name: CycleFinish0
        amount: 1
      - name: GroupScore
        amount: 50
      minimalCondition: []
    - text: Non
      idToGo: 
      statsToChange: []
      minimalCondition: []
  - id: Join
    speaker: Vous
    text: "T'inqui\xE8tes tout va rouler comme sur des roulettes cette fois."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: 0.32, y: 0.17, z: 0.3}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices: []
