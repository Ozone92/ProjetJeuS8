      - name: CycleFinish3
        amount: 1
      minimalCondition: []
  - id: Other
    speaker: Walter
    text: "Une id\xE9e forte int\xE9ressante"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Other2
      statsToChange: []
      minimalCondition: []
  - id: Other2
    speaker: Titouan
    text: "Mon tiktok il est mieux quand-m\xEAme"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Other3
      statsToChange: []
      minimalCondition: []
  - id: Other3
    speaker: Walter
    text: "Il faut savoir \xE9couter la sagesse des plus \xE2g\xE9s"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Other4
      statsToChange: []
      minimalCondition: []
  - id: Other4
