  dialogs:
  - id: Begin
    speaker: TItouan
    text: "Tu as pu choper des infos ? Tu veux qu\u2019on utilise quelle m\xE9thode
      ?"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: Secouer tres fort
      idToGo: Other
      statsToChange:
      - name: GroupScore
        amount: -1
      - name: TpScore
        amount: 0
      minimalCondition:
      - name: C3G1
        amount: 1
    - text: Utiliser la Loi de Henry
      idToGo: Other
      statsToChange:
      - name: GroupScore
        amount: -1
      - name: TpScore
        amount: 1
      minimalCondition:
      - name: C3G2
        amount: 1
    - text: Mettre de l'azote liquide et du gaz
      idToGo: Your
      statsToChange:
      - name: GroupScore
        amount: 1
      - name: TpScore
        amount: -1
      minimalCondition:
      - name: C3G3
        amount: 1
    - text: Continuer a discuter avec les autres
      idToGo: 
      statsToChange: []
      minimalCondition: []
  - id: Your
    speaker: Titouan
    text: "Je ressors le tiktok\u2026"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Your2
      statsToChange: []
      minimalCondition: []
  - id: Your2
    speaker: Walter
    text: "La vivacit\xE9 de la jeunesse m'impressionnera toujours, telle une anguille
      dans un champ de coton."
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Your3
      statsToChange: []
      minimalCondition: []
  - id: Your3
    speaker: Vous
    text: "Ne fait pas attention \xE0 ce qu\u2019il dit, la vieillesse fait des ravages"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.013, y: 0.171, z: 0.064}
    cameraRotation: {x: 0, y: 180, z: 0}
    choices:
    - text: 
      idToGo: Your4
      statsToChange: []
      minimalCondition: []
  - id: Your4
    speaker: Titouan
    text: "Je l\u2019ai retrouv\xE9e, on peut commencer"
    useDefaultCameraTransform: 0
    useSpecificCameraTransform: 0
    cameraPosition: {x: -0.146, y: 0.16, z: 0.18}
